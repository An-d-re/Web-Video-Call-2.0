# WebRTC 信令服务（C++/muduo）—— 环境变量范例
# 部署到 /opt/webrtc/signaling.env，权限 600

# HS256 密钥，≥32 字节，必须与 auth 服务的 JWT_SECRET **完全一致**。
# 注意：长度不足 32 字节时服务会直接拒绝启动（除非 AUTH_REQUIRED=false）。
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_BYTES

# 鉴权开关。默认 true。
# 设为 false 是应急回滚阀门：退回"匿名入房"，任何人知道房间号就能进。
# 只在排障时临时打开，别长期关着。
AUTH_REQUIRED=true
