# WebRTC 认证服务（Go）—— 环境变量范例
# 部署到 /opt/webrtc/auth.env，权限 600
#
# 全部配置都来自环境变量：这个服务是"纯二进制 + 环境变量"的可搬移单元，
# 不读任何配置文件。

# 监听地址。只监听回环，由 nginx 反代 /api/ —— 不要改成 0.0.0.0
AUTH_LISTEN=127.0.0.1:8080

# PostgreSQL 连接串
DATABASE_URL=postgres://webrtc:CHANGE_ME@127.0.0.1:5432/webrtc?sslmode=disable

# HS256 密钥，≥32 字节，必须与信令服务的 JWT_SECRET **完全一致**。
# 生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_BYTES

# 令牌有效期
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=168h

# secure cookie 只在 HTTPS 下才发得出去；用 http 调试时设 false
COOKIE_SECURE=true

# 是否允许注册。演示结束后想关掉注册就改 false
ALLOW_REGISTRATION=true

# 信任 X-Forwarded-For（服务在 nginx 后面，取真实 IP 用于限流）
TRUST_PROXY=true

# 跨域白名单，逗号分隔。前后端同源部署时留空即可（空 = 只接受同源）
# ALLOWED_ORIGINS=https://192.168.220.128
