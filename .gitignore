# 编译输出
out/
build/
server
*.o
*.a
*.so
*.d
*.ninja

# 第三方依赖 (如果 third_party 不是你写的代码，强烈建议排除)
third_party/

# 环境与密钥
.env
*.pem
*.key

# TURN/ICE 凭据（含明文口令，模板见 turn_config.example.json）
turn_config.json

# 本地工具配置
.claude/

# 日志与临时文件
*.log
logs/
.tmp/

# Go 构建缓存与模块缓存（放在工作区内，避免污染 C 盘）
.gocache/
.gopath/

# Go 构建产物
auth/auth-dev.exe
auth/auth

# 本地开发环境安装脚本的执行残留
_install/

# 本地开发网关的依赖与 npm 缓存（都在工作区内，避免污染 C 盘）
tools/dev-gateway/node_modules/
.npm-cache/
